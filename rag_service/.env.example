# Copy to .env for local runs and deploys. NEVER commit .env — it's in .gitignore and .dockerignore on purpose.
UNC_AI_API_KEY=your-gateway-key-from-canvas-inbox
# Your own front-door key for the deployed service. Make one:  python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_API_KEY=change-me
# Your onyen — deploy.sh names your app rag-<onyen> and tags everything it creates with it
ONYEN=your-onyen
